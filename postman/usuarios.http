# CRUD de usuarios. Solo administrador.
@baseUrl = http://localhost:8080

### 01 - Login administrador | 200
# @name admin
# @prompt password Clave del administrador
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@ort.com",
  "password": "{{password}}"
}

### 02 - Crear usuario | 201
# @name usuario
POST {{baseUrl}}/usuarios
Authorization: Bearer {{admin.response.body.$.token}}
Content-Type: application/json

{
  "nombre": "Juan Perez",
  "email": "juan.{{$guid}}@example.com"
}

### 03 - Consultar usuario | 200
GET {{baseUrl}}/usuarios/{{usuario.response.body.$.id}}
Authorization: Bearer {{admin.response.body.$.token}}

### 04 - Modificar usuario | 200
PUT {{baseUrl}}/usuarios/{{usuario.response.body.$.id}}
Authorization: Bearer {{admin.response.body.$.token}}
Content-Type: application/json

{
  "nombre": "Juan Actualizado"
}

### 05 - Eliminar usuario | 204
DELETE {{baseUrl}}/usuarios/{{usuario.response.body.$.id}}
Authorization: Bearer {{admin.response.body.$.token}}
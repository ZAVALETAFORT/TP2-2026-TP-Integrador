# Autenticacion y permisos.
@baseUrl = http://localhost:8080


### 01 - Registrar cliente | 201
# @name registro
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Cliente Auth",
  "email": "auth.{{$guid}}@example.com",
  "password": "Cliente123"
}


### 02 - Login y obtener JWT | 200
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{registro.response.body.$.email}}",
  "password": "Cliente123"
}


### 03 - Acceso sin token | 401
GET {{baseUrl}}/usuarios


### 04 - Cliente sin permiso de administrador | 403
GET {{baseUrl}}/usuarios
Authorization: Bearer {{login.response.body.$.token}}
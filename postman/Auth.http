# TP2 - Registro y login JWT
# Usar con VS Code REST Client. Ejecutar las solicitudes EN ORDEN.
# Iniciar la API con una base vacía:
#   PERSISTENCE_TYPE=memory MOCK_ENABLED=false npm start
# o:
#   PERSISTENCE_TYPE=sequelize SQLITE_STORAGE=:memory: MOCK_ENABLED=false npm start
# No reiniciar el servidor Memory entre las pruebas.
# El token NO protege endpoints todavía: esa es la siguiente fase.

@baseUrl = http://localhost:8080

### 01 - Registrar a Pedro | ESPERADO: 201; sin passwordHash
# @name registroPedro
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Pedro",
  "email": "pedro.auth.tp2@example.com",
  "password": "MiClave123!"
}

### 02 - Obtener al usuario registrado | ESPERADO: 200; sin passwordHash
GET {{baseUrl}}/usuarios/{{registroPedro.response.body.$.id}}

### 03 - Listar usuarios | ESPERADO: 200
GET {{baseUrl}}/usuarios

### 04 - Registrar el mismo email | ESPERADO: 409 EMAIL_DUPLICATED
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Pedro Duplicado",
  "email": "pedro.auth.tp2@example.com",
  "password": "OtraClave123!"
}

### 05 - Email duplicado con mayúsculas y espacios | ESPERADO: 409 EMAIL_DUPLICATED
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Otro Pedro",
  "email": "  PEDRO.AUTH.TP2@EXAMPLE.COM  ",
  "password": "OtraClave123!"
}

### 06 - Contraseña corta | ESPERADO: 400 VALIDACION_ERROR
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Juan",
  "email": "juan.auth.tp2@example.com",
  "password": "123"
}

### 07 - Email inválido | ESPERADO: 400 VALIDACION_ERROR
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Juan",
  "email": "correo-invalido",
  "password": "MiClave123!"
}

### 08 - Nombre demasiado corto | ESPERADO: 400 VALIDACION_ERROR
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "J",
  "email": "j.auth.tp2@example.com",
  "password": "MiClave123!"
}

### 09 - Intentar autoasignar rol admin | ESPERADO: 400 VALIDACION_ERROR
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Admin Falso",
  "email": "adminfalso.auth.tp2@example.com",
  "password": "MiClave123!",
  "rol": "admin"
}

### 10 - Registro sin password | ESPERADO: 400 VALIDACION_ERROR
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "María",
  "email": "maria.auth.tp2@example.com"
}

### 11 - Login válido | ESPERADO: 200; token y user sin passwordHash
# @name loginPedro
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "pedro.auth.tp2@example.com",
  "password": "MiClave123!"
}

### 12 - Login con email en mayúsculas | ESPERADO: 200
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "PEDRO.AUTH.TP2@EXAMPLE.COM",
  "password": "MiClave123!"
}

### 13 - Login con contraseña incorrecta | ESPERADO: 401 INVALID_CREDENTIALS
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "pedro.auth.tp2@example.com",
  "password": "incorrecta"
}

### 14 - Login con email inexistente | ESPERADO: 401 INVALID_CREDENTIALS
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "noexiste.auth.tp2@example.com",
  "password": "MiClave123!"
}

### 15 - Login sin contraseña | ESPERADO: 400 VALIDACION_ERROR
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "pedro.auth.tp2@example.com"
}

### 16 - Login con email inválido | ESPERADO: 400 VALIDACION_ERROR
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "no-es-email",
  "password": "MiClave123!"
}

### 17 - Login con JSON malformado | ESPERADO: 400 INVALID_JSON
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"email":"pedro.auth.tp2@example.com", "password":

### 18 - Acceder a un usuario inexistente | ESPERADO: 404 USUARIO_NOT_FOUND
GET {{baseUrl}}/usuarios/999999

### 19 - Verificar que /auth/register no acepta GET | ESPERADO: 404 ROUTE_NOT_FOUND
GET {{baseUrl}}/auth/register

### 20 - Registrar otro usuario para comprobar IDs distintos | ESPERADO: 201
# @name registroAna
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Ana",
  "email": "ana.auth.tp2@example.com",
  "password": "OtraClave123!"
}

### 21 - Consultar a Ana | ESPERADO: 200; ID distinto de Pedro
GET {{baseUrl}}/usuarios/{{registroAna.response.body.$.id}}

### 22 - Login de Ana | ESPERADO: 200; token del nuevo usuario
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "ana.auth.tp2@example.com",
  "password": "OtraClave123!"
}

### 23 - Estado del servidor | ESPERADO: 200
GET {{baseUrl}}/health

### 24 - Usuario creado por CRUD anterior (sin contraseña) | ESPERADO: 201
# @name usuarioSinClave
POST {{baseUrl}}/usuarios
Content-Type: application/json

{
  "nombre": "Usuario sin clave",
  "email": "sinclave.auth.tp2@example.com"
}

### 25 - Usuario del CRUD anterior no puede hacer login | ESPERADO: 401 INVALID_CREDENTIALS
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "sinclave.auth.tp2@example.com",
  "password": "MiClave123!"
}
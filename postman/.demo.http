# Demo principal TP2 - ejecutar en orden.
# Administrador de pruebas: admin@ort.com / admin123

@baseUrl = http://localhost:8080


### 01 - Login administrador | 200
# @name admin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@ort.com",
  "password": "admin123"
}


### 02 - Registrar cliente | 201
# @name cliente
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Cliente Demo",
  "email": "demo.{{$guid}}@example.com",
  "password": "Cliente123"
}


### 03 - Login cliente | 200
# @name loginCliente
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{cliente.response.body.$.email}}",
  "password": "Cliente123"
}


### 04 - Crear pelicula como administrador | 201
# @name pelicula
POST {{baseUrl}}/peliculas
Authorization: Bearer {{admin.response.body.$.token}}
Content-Type: application/json

{
  "titulo": "Interestelar",
  "fechaProyeccion": "2027-02-20T21:00:00-03:00",
  "capacidadTotal": 3
}


### 05 - Cliente reserva 2 lugares | 201
# @name reserva
POST {{baseUrl}}/reservas
Authorization: Bearer {{loginCliente.response.body.$.token}}
Content-Type: application/json

{
  "peliculaId": {{pelicula.response.body.$.id}},
  "cantidad": 2
}


### 06 - Verificar disponibilidad: queda 1 lugar | 200
GET {{baseUrl}}/peliculas/{{pelicula.response.body.$.id}}
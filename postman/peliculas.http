# CRUD de peliculas. Escritura solo administrador.
@baseUrl = http://localhost:8080


### 01 - Login administrador | 200
# @name admin
# @prompt password Clave del administrador
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@ort.com",
  "password": "{{password}}"
}


### 02 - Crear pelicula | 201
# @name pelicula
POST {{baseUrl}}/peliculas
Authorization: Bearer {{admin.response.body.$.token}}
Content-Type: application/json

{
  "titulo": "Matrix",
  "fechaProyeccion": "2027-03-20T21:00:00-03:00",
  "capacidadTotal": 10
}


### 03 - Consultar pelicula (publico) | 200
GET {{baseUrl}}/peliculas/{{pelicula.response.body.$.id}}


### 04 - Modificar capacidad | 200
PUT {{baseUrl}}/peliculas/{{pelicula.response.body.$.id}}
Authorization: Bearer {{admin.response.body.$.token}}
Content-Type: application/json

{
  "capacidadTotal": 15
}


### 05 - Eliminar pelicula | 204
DELETE {{baseUrl}}/peliculas/{{pelicula.response.body.$.id}}
Authorization: Bearer {{admin.response.body.$.token}}
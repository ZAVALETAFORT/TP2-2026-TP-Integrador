# Reservas: crear, consultar, cancelar y verificar cupos.
@baseUrl = http://localhost:8080


### 01 - Login administrador | 200
# @name admin
# @prompt password Clave del administrador
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@ort.com",
  "password": "{{password}}"
}


### 02 - Crear pelicula con 3 lugares | 201
# @name pelicula
POST {{baseUrl}}/peliculas
Authorization: Bearer {{admin.response.body.$.token}}
Content-Type: application/json

{
  "titulo": "Pelicula Reservas",
  "fechaProyeccion": "2027-04-20T21:00:00-03:00",
  "capacidadTotal": 3
}


### 03 - Registrar cliente | 201
# @name cliente
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Cliente Reserva",
  "email": "reserva.{{$guid}}@example.com",
  "password": "Cliente123"
}


### 04 - Login cliente | 200
# @name loginCliente
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{cliente.response.body.$.email}}",
  "password": "Cliente123"
}


### 05 - Crear reserva de 2 lugares | 201
# @name reserva
POST {{baseUrl}}/reservas
Authorization: Bearer {{loginCliente.response.body.$.token}}
Content-Type: application/json

{
  "peliculaId": {{pelicula.response.body.$.id}},
  "cantidad": 2
}


### 06 - Consultar mis reservas | 200
GET {{baseUrl}}/reservas
Authorization: Bearer {{loginCliente.response.body.$.token}}


### 07 - Cancelar reserva | 200
PUT {{baseUrl}}/reservas/{{reserva.response.body.$.id}}
Authorization: Bearer {{loginCliente.response.body.$.token}}
Content-Type: application/json

{
  "estado": "cancelada"
}


### 08 - Verificar cuposDisponibles = 3 | 200
GET {{baseUrl}}/peliculas/{{pelicula.response.body.$.id}}
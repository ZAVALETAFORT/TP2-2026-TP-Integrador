@baseUrl = http://localhost:8080
@adminEmail = admin@ort.com
@adminPassword = admin123
@clientePassword = cliente123

### 01 - Login administrador
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### 02 - Registrar cliente
# @name registroCliente
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Cliente Demo",
  "email": "cliente.{{$guid}}@ort.com",
  "password": "{{clientePassword}}"
}

### 03 - Login cliente
# @name loginCliente
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{registroCliente.response.body.$.email}}",
  "password": "{{clientePassword}}"
}

### 04 - Admin crea pelicula
# @name pelicula
POST {{baseUrl}}/peliculas
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "titulo": "Interestelar",
  "fechaProyeccion": "2027-02-20T21:00:00-03:00",
  "capacidadTotal": 3
}

### 05 - Cliente crea reserva
# @name reserva
POST {{baseUrl}}/reservas
Authorization: Bearer {{loginCliente.response.body.$.token}}
Content-Type: application/json

{
  "peliculaId": {{pelicula.response.body.$.id}},
  "cantidad": 2
}

### 06 - Cliente consulta sus reservas
GET {{baseUrl}}/reservas
Authorization: Bearer {{loginCliente.response.body.$.token}}

### 07 - Consultar sin token
GET {{baseUrl}}/reservas

### 08 - Cliente intenta reservar para otro usuario
POST {{baseUrl}}/reservas
Authorization: Bearer {{loginCliente.response.body.$.token}}
Content-Type: application/json

{
  "usuarioId": {{loginAdmin.response.body.$.user.id}},
  "peliculaId": {{pelicula.response.body.$.id}},
  "cantidad": 1
}

### 09 - Superar los cupos disponibles
PUT {{baseUrl}}/reservas/{{reserva.response.body.$.id}}
Authorization: Bearer {{loginCliente.response.body.$.token}}
Content-Type: application/json

{
  "cantidad": 4
}

### 10 - Cancelar reserva
PUT {{baseUrl}}/reservas/{{reserva.response.body.$.id}}
Authorization: Bearer {{loginCliente.response.body.$.token}}
Content-Type: application/json

{
  "estado": "cancelada"
}

### 11 - Verificar devolucion de cupos
GET {{baseUrl}}/peliculas/{{pelicula.response.body.$.id}}

### 12 - Eliminar reserva
DELETE {{baseUrl}}/reservas/{{reserva.response.body.$.id}}
Authorization: Bearer {{loginCliente.response.body.$.token}}
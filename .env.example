#Puerto de la APP (8080 por defecto)
PORT=8080

# Entorno de ejecución: development, production o test
NODE_ENV=development

#Persistencia de la DDBB (memory, sequelize)
PERSISTENCE_TYPE=sequelize

#Archivo de SQLite (si se usa sequelize)
SQLITE_STORAGE=data/cine.sqlite

# Swagger y OpenAPI
DOCS_ENABLED=true

# Mock con precarga de datos (DB vacia: false)
MOCK_ENABLED=true

# Hasheo: costo de bcrypt al generar contraseñas
BCRYPT_ROUNDS=10
